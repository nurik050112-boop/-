# Скопируй этот файл в .env и вставь свои ключи из Supabase.
# Где взять: supabase.com → твой проект → Project Settings → API Keys → Publishable key
# ⚠️  .env НИКОГДА не коммить в git (он уже в .gitignore).

VITE_SUPABASE_URL=https://ТВОЙ-ПРОЕКТ.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_твой-публичный-ключ

# День 5: убери # и вставь ключ из aistudio.google.com/apikey.
# Без префикса VITE_ этот ключ не попадёт во фронтенд.
# GEMINI_API_KEY=твой-секретный-ключ
